# Backend Environment Configuration Template
# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Database Configuration:
# For local development:
# MONGODB_URI=mongodb://127.0.0.1:27017/placement_portal
# For cloud deployment (MongoDB Atlas):
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/placement_portal?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRE=30d

# Frontend CORS Allowed Origins (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://placement-guide-nu.vercel.app

# SMTP / Email Notification Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
