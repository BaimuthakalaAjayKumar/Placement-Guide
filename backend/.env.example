# Backend Environment Configuration Template
# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Database Configuration:
# For local development:
# MONGODB_URI=mongodb://127.0.0.1:27017/placement_portal
# For cloud deployment (MongoDB Atlas):
MONGODB_URI=mongodb+srv://vaddeajaykumar2004:<AjayKumar9182>@cluster0.no8rx.mongodb.net/?appName=Cluster0

# JWT Authentication
JWT_SECRET=super_secret_key_placement_portal_jwt_2026
JWT_EXPIRE=30d

# Frontend CORS Allowed Origins (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://placement-guide-nu.vercel.app

# SMTP / Email Notification Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=campusconnect.supportdesk@gmail.com
SMTP_PASSWORD=your_16_digit_google_app_password

# AI Chatbot Integration (Optional - Powered by ChatGPT / OpenAI)
# Add your OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Alternative: Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=

# Cloudflare Turnstile CAPTCHA (Required for Mobile App Authentication)
# Obtain secret key from Cloudflare Turnstile Dashboard
TURNSTILE_SECRET_KEY=

# Optional: Enforce CAPTCHA on all platforms including web (default is false)
REQUIRE_CAPTCHA=false
